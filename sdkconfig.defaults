# M5Stack Tab5 (ESP32-P4, 16 MB flash, 32 MB PSRAM)
CONFIG_IDF_TARGET="esp32p4"

# Chip revision: the Tab5 has shipped with pre-v3 silicon (v1.x). For a v3.x chip
# remove the next line (or pick "ESP32-P4 revision >= v3.0" in menuconfig).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_CACHE_L2_CACHE_512KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# The Tab5's USB-C port is the P4's USB Serial/JTAG (UART0 is not wired to it)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# the emulator task never yields
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_DYN_BUFFERS=y
CONFIG_FATFS_USE_FASTSEEK=y

# Wi-Fi: ESP-Hosted over SDIO to the on-board ESP32-C6 (SDMMC slot 1; the
# microSD card is slot 0 of the same controller). main/net_tab5.c starts it.
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST=y
CONFIG_ESP_HOSTED_HOST_TYPE_MCU=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=15
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
# lwIP buffers in PSRAM: internal RAM is short with the 512 KB L2 cache
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# SNTP asks as soon as there is an address (no random start-up delay): boot waits for it
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# lets main/linker.lf put the CPU fast path's .bss (TLB) in PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
